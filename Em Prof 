doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#204e39"><title>PlantEase | Gardening made simpler</title><style>
:root{--green:#204e39;--cream:#f7f8f2;--line:#dfe5da;--ink:#243e30}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--cream);font:16px system-ui,sans-serif}button,input,select,textarea{font:inherit}button,a{touch-action:manipulation}button{cursor:pointer}a{color:inherit}header{background:white;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5;padding:16px max(20px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;gap:15px}.logo{font-size:26px;font-weight:800;letter-spacing:-1px;text-decoration:none}nav{display:flex;gap:8px;flex-wrap:wrap}.btn{background:var(--green);color:white;border:1px solid var(--green);padding:11px 16px;border-radius:10px;font-weight:650}.light{background:white;color:var(--green);border:1px solid var(--line)}.danger{color:#9a3029}.wrap{max-width:1180px;margin:auto;padding:24px 20px}.notice{font-size:12px;background:#e9efdf;padding:10px 20px;text-align:center}.hero{background:#e3eddc;padding:44px;border-radius:22px;margin-bottom:30px}.eyebrow{font-size:11px;font-weight:750;letter-spacing:2px}h1{font-size:clamp(30px,5vw,52px);letter-spacing:-1.5px;max-width:760px;margin:14px 0}h2{font-size:26px}p{line-height:1.65}.hero p{max-width:700px;color:#52654e}.features{display:flex;flex-wrap:wrap;gap:9px;margin-top:23px}.pill{background:#ffffffa8;padding:7px 12px;border-radius:20px;font-size:12px}.tools{display:flex;gap:12px;flex-wrap:wrap;margin:15px 0}input,select,textarea{border:1px solid #bfcbbb;border-radius:8px;padding:11px;background:white;color:var(--ink);max-width:100%}input[type=search]{flex:1;min-width:160px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #ba8d39;outline-offset:3px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.filters button{border:1px solid var(--line);background:white;padding:9px 13px;border-radius:22px;color:var(--ink)}.filters .active{background:var(--green);color:white}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden}.art{height:145px;background:#e8efdf;display:flex;align-items:center;justify-content:center;color:#4b7045}.art svg{width:105px;height:105px}.content{padding:20px}.category{font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:#6f8068}.card h3{margin:9px 0;font-size:18px}.card p{font-size:13px;color:#697863;min-height:64px}.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.price{font-size:20px;font-weight:750}.muted{font-size:13px;color:#6f7d68}.panel{border:1px solid var(--line);border-radius:16px;background:white;padding:24px;margin:18px 0}.section{display:none}.section.active{display:block}.cartline{display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;border-bottom:1px solid var(--line);padding:17px 0}.qty{display:flex;align-items:center;gap:10px}.qty button{border:1px solid var(--line);background:white;border-radius:7px;min-width:34px;min-height:34px;color:var(--green)}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}label{display:block;font-size:13px;font-weight:600}label input:not([type=checkbox]),label select,label textarea{width:100%;margin-top:6px}.full{grid-column:1/-1}.check{display:flex;align-items:flex-start;gap:10px;margin:13px 0;line-height:1.6}.check input{margin-top:6px;accent-color:var(--green)}.total{font-size:22px;font-weight:750}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--green);color:white;padding:13px 22px;border-radius:10px;z-index:20;box-shadow:0 4px 25px #0002}.empty{padding:35px;background:white;border:1px dashed #b7c6ae;border-radius:15px;text-align:center}.order{border-bottom:1px solid var(--line);padding:20px 0}.order:last-child{border:0}.helpgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}footer{padding:35px 20px;background:#173c2c;color:#d8e4d5;margin-top:35px;font-size:12px}footer .wrap{padding:0}#status{min-height:20px}.warning{border-left:4px solid #a48534;background:#faf4df;padding:13px;font-size:13px;line-height:1.6}details{margin:15px 0;line-height:1.7}summary{cursor:pointer;font-weight:650}@media(max-width:800px){.grid{grid-template-columns:repeat(2,1fr)}.hero{padding:28px}.helpgrid{grid-template-columns:1fr}header{align-items:flex-start}.logo{font-size:23px}nav .btn{font-size:12px;padding:9px 10px}}@media(max-width:480px){.grid{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.cartline{grid-template-columns:1fr auto}.cartline>.btn{grid-column:1/-1}.hero{padding:23px}header{flex-direction:column;gap:12px}.card p{min-height:0}.art{height:120px}}@media print{header,nav,.btn,.notice,footer,.filters,.tools{display:none}.section{display:none!important}#history{display:block!important}.wrap{padding:0}.panel{border:0}}
</style></head><body><div class="notice">MVP DEMO · Sample prices · Requests stay on this device and are not sent to PlantEase.</div><header><a class="logo" href="#shop" onclick="go('shop')">PlantEase.</a><nav aria-label="Main navigation"><button class="btn light" onclick="go('shop')">Shop</button><button class="btn light" onclick="go('help')">How it works</button><button class="btn light" onclick="go('history')">My requests</button><button class="btn" onclick="go('cart')">Cart (<span id="count">0</span>)</button></nav></header><main class="wrap"><section class="section active" id="shop"><div class="hero"><span class="eyebrow">WE SELL, WE PLANT</span><h1>A little green.<br>A simpler start.</h1><p>Shop plants, seeds, soil, fertilizers, and basic gardening tools. Build your own starter package and add optional delivery or planting assistance.</p><div class="features"><span class="pill">Five essential categories</span><span class="pill">Flexible product selection</span><span class="pill">Optional planting help</span></div></div><h2>Find your gardening essentials</h2><p class="muted">Illustrative catalog. Every price, product specification, and stock position needs confirmation before a real sale.</p><div class="tools"><input id="search" type="search" placeholder="Search plants, soil, tools…" aria-label="Search products" oninput="renderProducts()"><select id="sort" aria-label="Sort products" onchange="renderProducts()"><option value="default">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option><option value="name">Name: A–Z</option></select></div><div class="filters" id="filters" aria-label="Product categories"></div><p class="muted" id="productCount" aria-live="polite"></p><div class="grid" id="products"></div></section><section class="section" id="cart"><h1 style="font-size:34px">Your gardening basket</h1><p class="muted">Choose what you need. Products and services are not automatically bundled.</p><div class="panel" id="cartItems"></div><div id="checkoutArea"><form id="checkout" class="panel"><h2>Build your request</h2><p class="warning">This checkout saves a demo request only on this browser. Do not enter real personal details. No payment is collected and no appointment is confirmed.</p><div class="fields"><label>Demo customer name<input name="customer" required maxlength="80" placeholder="Sample Customer" autocomplete="off"></label><label>General area — fictional only<input name="area" required maxlength="100" placeholder="Sample Area A" autocomplete="off"></label><label>Preferred date<input name="date" type="date" required></label><label>Preferred time window<select name="time" required><option value="">Select a preference</option><option>Morning</option><option>Afternoon</option></select></label><label class="full">Notes — no sensitive information<textarea name="notes" rows="3" maxlength="400" placeholder="Example: Please confirm the potting mix and tool contents."></textarea></label></div><h3>Optional services</h3><label class="check"><input type="checkbox" id="delivery" onchange="renderTotals()"><span>Delivery — sample fee ₱50 per request</span></label><label class="check"><input type="checkbox" id="planting" onchange="renderTotals()"><span>Planting assistance — sample fee ₱70 for one small plant. Other work needs a separate quote.</span></label><p class="muted">The customer supplies a suitable pot. Soil and other supplies are charged separately if selected. Final scope, transport, and site suitability must be checked.</p><div id="totals"></div><label class="check"><input type="checkbox" required><span>I understand this is a local demo, prices are illustrative, and the request is not sent to PlantEase.</span></label><button class="btn" type="submit">Save demo request</button></form></div></section><section class="section" id="history"><h1 style="font-size:34px">My saved requests</h1><p class="muted">Stored only in this browser. Clearing browser data may remove these records. No request below has been sent to PlantEase.</p><div class="row"><button class="btn light" onclick="exportRequests()">Export requests (JSON)</button><button class="btn light danger" onclick="clearRequests()">Delete local history</button></div><div id="requests"></div></section><section class="section" id="help"><h1 style="font-size:34px">From first plant to first request.</h1><div class="helpgrid"><article class="panel"><span class="eyebrow">01 / CHOOSE</span><h2>Find your essentials</h2><p>Browse the five categories. Add individual products or combine them into a starter package.</p></article><article class="panel"><span class="eyebrow">02 / CUSTOMIZE</span><h2>Add a little help</h2><p>Adjust quantities and select optional delivery or planting assistance. Check every charge before proceeding.</p></article><article class="panel"><span class="eyebrow">03 / REVIEW</span><h2>Save a demo request</h2><p>Choose a preferred date and save a sample request. This version records it locally; it does not contact the business.</p></article></div><div class="panel"><h2>Frequently asked questions</h2><details><summary>Are the prices final?</summary>No. Catalog and service prices are illustrative. Real prices, stock, sizes, and specifications must be confirmed.</details><details><summary>Are soil, fertilizer, seeds, and tools included with every plant?</summary>No. They are core product categories, but you choose and pay for each item separately unless a future package explicitly includes it.</details><details><summary>What does planting assistance include?</summary>The sample service fee represents help with one small plant in a customer-provided suitable pot. Materials and additional work need confirmation.</details><details><summary>Can I pay or place a real order here?</summary>No. There is no payment processor or order server in this version. Requests remain on your device.</details><details><summary>How should I choose plants, seeds, or fertilizers?</summary>Confirm the exact product and its suitability before buying. Follow the actual seed or fertilizer label; this mock-up does not provide product-specific instructions.</details></div></section><p id="status" class="muted" role="status" aria-live="polite"></p></main><footer><div class="wrap"><strong style="font-size:22px">PlantEase.</strong><p>Your plants, gardening essentials, and planting help—all in one place.</p><p>Fully coded static MVP · No accounts, shared inventory, real payments, or server-side orders.<br>Use fictional details only. Sample product illustrations are not actual inventory photographs.</p></div></footer><script>
const products=[{"id": 1, "name": "Starter foliage plant", "category": "Plants", "price": 150, "description": "A sample small potted plant. Variety and placement suitability require confirmation."}, {"id": 2, "name": "Flowering plant", "category": "Plants", "price": 220, "description": "Sample flowering plant in a nursery pot. Availability must be confirmed."}, {"id": 3, "name": "Vegetable seed pack", "category": "Seeds", "price": 45, "description": "Sample seed pack. Variety, quantity, and planting season to be confirmed."}, {"id": 4, "name": "Flower seed pack", "category": "Seeds", "price": 55, "description": "Sample flower seeds for a starter garden. Check variety before purchase."}, {"id": 5, "name": "Potting mix · sample bag", "category": "Soil", "price": 90, "description": "Illustrative bag of potting mix. Volume and ingredients require confirmation."}, {"id": 6, "name": "Garden soil · sample bag", "category": "Soil", "price": 65, "description": "Illustrative garden soil product. Check the mix for your planting needs."}, {"id": 7, "name": "Plant fertilizer · sample pack", "category": "Fertilizers", "price": 85, "description": "Fertilizer type and pack size to be confirmed. Follow the actual product label."}, {"id": 8, "name": "Hand trowel", "category": "Gardening Tools", "price": 110, "description": "A basic hand tool for small planting tasks."}, {"id": 9, "name": "Gardening gloves", "category": "Gardening Tools", "price": 75, "description": "Sample gardening gloves. Size and material to be confirmed."}, {"id": 10, "name": "Watering can", "category": "Gardening Tools", "price": 180, "description": "Sample watering can. Capacity and availability to be confirmed."}, {"id": 11, "name": "Basic tool set", "category": "Gardening Tools", "price": 250, "description": "Illustrative starter set. Exact tools and sizes must be confirmed."}];
const money=n=>new Intl.NumberFormat('en-PH',{style:'currency',currency:'PHP'}).format(n);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let storageOK=true;function load(key,fallback){try{const v=JSON.parse(localStorage.getItem(key));return v===null?fallback:v}catch(e){return fallback}}
let cart=load('plantease_cart_v1',{}),requests=load('plantease_requests_v1',[]),category='All';
if(!cart||typeof cart!=='object'||Array.isArray(cart))cart={};if(!Array.isArray(requests))requests=[];
Object.keys(cart).forEach(id=>{if(!products.some(p=>p.id===Number(id))||!Number.isInteger(cart[id])||cart[id]<1||cart[id]>99)delete cart[id]});
function save(){try{localStorage.setItem('plantease_cart_v1',JSON.stringify(cart));localStorage.setItem('plantease_requests_v1',JSON.stringify(requests));storageOK=true;return true}catch(e){storageOK=false;document.getElementById('status').textContent='Browser storage is unavailable or full. Changes cannot be saved persistently. Export requests before leaving.';return false}}
function toast(text){document.querySelector('.toast')?.remove();const x=document.createElement('div');x.className='toast';x.setAttribute('role','status');x.textContent=text;document.body.appendChild(x);setTimeout(()=>x.remove(),2800)}
function go(id){if(!['shop','cart','history','help'].includes(id))id='shop';document.querySelectorAll('.section').forEach(x=>x.classList.toggle('active',x.id===id));if(id==='cart')renderCart();if(id==='history')renderHistory();location.hash=id;window.scrollTo({top:0,behavior:'smooth'})}
window.addEventListener('hashchange',()=>{let id=location.hash.slice(1);if(document.getElementById(id)?.classList.contains('section')){document.querySelectorAll('.section').forEach(x=>x.classList.toggle('active',x.id===id));if(id==='cart')renderCart();if(id==='history')renderHistory()}});
function icon(c){let shape=c==='Plants'?'<path d="M44 90V40M44 61C12 61 13 22 44 40M45 49C78 49 84 9 46 29" fill="none" stroke="currentColor" stroke-width="5"/><path d="M25 73h40l-6 28H31z" fill="currentColor"/>':c==='Seeds'?'<rect x="25" y="16" width="60" height="88" rx="8" fill="none" stroke="currentColor" stroke-width="4"/><ellipse cx="54" cy="58" rx="11" ry="20" transform="rotate(25 54 58)" fill="currentColor"/>':c==='Gardening Tools'?'<path d="M56 60v43M43 60V28q13-22 26 0v32z" fill="none" stroke="currentColor" stroke-width="6"/>':'<path d="M30 18h53l8 83H21z" fill="none" stroke="currentColor" stroke-width="4"/><path d="M39 51h34M39 65h34M39 79h23" stroke="currentColor" stroke-width="4"/>';return '<svg viewBox="0 0 110 115" aria-hidden="true">'+shape+'</svg>'}
function renderFilters(){const cats=['All',...new Set(products.map(p=>p.category))];document.getElementById('filters').innerHTML=cats.map(c=>'<button class="'+(c===category?'active':'')+'" aria-pressed="'+(c===category)+'" onclick="filter('+cats.indexOf(c)+')">'+esc(c)+'</button>').join('')}
function filter(i){category=['All',...new Set(products.map(p=>p.category))][i];renderFilters();renderProducts()}
function renderProducts(){const q=document.getElementById('search').value.toLowerCase().trim();let list=products.filter(p=>(category==='All'||p.category===category)&&(p.name+' '+p.category+' '+p.description).toLowerCase().includes(q));const sort=document.getElementById('sort').value;if(sort==='low')list.sort((a,b)=>a.price-b.price);if(sort==='high')list.sort((a,b)=>b.price-a.price);if(sort==='name')list.sort((a,b)=>a.name.localeCompare(b.name));document.getElementById('productCount').textContent=list.length+' sample products';document.getElementById('products').innerHTML=list.length?list.map(p=>'<article class="card"><div class="art">'+icon(p.category)+'</div><div class="content"><span class="category">'+esc(p.category)+'</span><h3>'+esc(p.name)+'</h3><p>'+esc(p.description)+'</p><div class="row"><span class="price">'+money(p.price)+'</span><button class="btn" onclick="add('+p.id+')" aria-label="Add '+esc(p.name)+' to cart">Add to cart</button></div></div></article>').join(''):'<div class="empty">No matching products. Try another search or category.</div>'}
function add(id){cart[id]=Math.min(99,(cart[id]||0)+1);save();count();toast('Added to your cart')}
function count(){document.getElementById('count').textContent=Object.values(cart).reduce((a,b)=>a+b,0)}
function change(id,delta){cart[id]=(cart[id]||0)+delta;if(cart[id]<=0)delete cart[id];if(cart[id]>99)cart[id]=99;save();count();renderCart()}
function removeItem(id){delete cart[id];save();count();renderCart()}
function subtotal(){return products.reduce((sum,p)=>sum+(cart[p.id]||0)*p.price,0)}
function totals(){const sub=subtotal(),delivery=document.getElementById('delivery').checked?50:0,planting=document.getElementById('planting').checked?70:0;return {subtotal:sub,delivery,planting,total:sub+delivery+planting}}
function renderTotals(){const a=totals();document.getElementById('totals').innerHTML='<div class="panel"><div class="row"><p>Products</p><span>'+money(a.subtotal)+'</span></div><div class="row"><p>Delivery</p><span>'+money(a.delivery)+'</span></div><div class="row"><p>Planting assistance</p><span>'+money(a.planting)+'</span></div><hr style="border:0;border-top:1px solid var(--line)"><div class="row total"><span>Sample total</span><span>'+money(a.total)+'</span></div><p class="muted">Not a final quotation. No payment collected.</p></div>'}
function renderCart(){let list=products.filter(p=>cart[p.id]);document.getElementById('checkoutArea').hidden=!list.length;document.getElementById('cartItems').innerHTML=list.length?list.map(p=>'<div class="cartline"><div><strong>'+esc(p.name)+'</strong><p class="muted">'+money(p.price)+' each · '+money(p.price*cart[p.id])+'</p></div><div class="qty"><button type="button" aria-label="Decrease quantity for '+esc(p.name)+'" onclick="change('+p.id+',-1)">−</button><span>'+cart[p.id]+'</span><button type="button" aria-label="Increase quantity for '+esc(p.name)+'" onclick="change('+p.id+',1)">+</button></div><button class="btn light danger" type="button" onclick="removeItem('+p.id+')">Remove</button></div>').join(''):'<div class="empty"><h2>Your cart is ready for a fresh start.</h2><p>Add a plant or a few gardening essentials.</p><button class="btn" onclick="go('shop')">Browse products</button></div>';renderTotals()}
const form=document.getElementById('che